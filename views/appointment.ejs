<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>User Appointment Page</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <link href="https://fonts.googleapis.com/css2?family=Ubuntu:wght@700&display=swap" rel="stylesheet">
    <style>
        body {
            background-color: #0ccf2d;
            font-family: "Ubuntu", sans-serif; /* Ensures proper fallback */
        }

        .appointment-header {
            margin: 20px 0;
            text-align: center;
        }

        .doctor-card {
            margin: 15px;
            padding: 20px;
            border-radius: 1rem;
            background-color: #fff;
            box-shadow: 0 2px 15px rgba(0, 0, 0, 0.2);
            text-align: center;
            flex: 1 0 21%; /* 4 cards per row */
        }

        .doctor-img {
            max-width: 100%;
            height: auto;
            border-radius: 8px;
        }

        .price {
            font-size: 1.5rem;
            margin: 10px 0;
        }

        .btn {
            background-color: #0ccf2d;
            color: white;
            border: none;
            padding: 10px 20px;
            border-radius: 5px;
            cursor: pointer;
        }

        .btn:hover {
            opacity: 0.8;
        }

        @media (max-width: 768px) {
            .doctor-card {
                flex: 1 0 46%; /* 2 cards per row on smaller screens */
            }
        }

        @media (max-width: 576px) {
            .doctor-card {
                flex: 1 0 100%; /* 1 card per row on very small screens */
            }
        }

        #successMessage {
            display: none; /* Hidden by default */
            position: fixed;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            background-color: white;
            padding: 20px;
            border-radius: 5px;
            z-index: 1000; /* Ensure it appears above other content */
        }
    </style>
</head>

<body>
    <div class="container">
        <div class="appointment-header">
            <h1>Get an Appointment!!!!</h1>
        </div>
        <h2 class="text-center">Available Doctors</h2>

        <div class="row">
            <% doctors.forEach(doctor => { %>
                <div class="col-md-3">
                    <div class="doctor-card">
                        <img class="doctor-img" src="\images\doc-dashboard-blog.png" alt="app">
                        <h5 style="color: #0ccf2d;">Dr. <%= doctor.name %></h5>
                        <div class="price">Price: Rs. <%= Math.floor(Math.random() * (1000 - 500 + 1)) + 500 %></div>
                        <button class="btn btn-outline-light btn-sm book-button"
                            onclick="confirmAppointment('<%= doctor._id %>')">Book Appointment</button>
                    </div>
                </div>
            <% }); %>
        </div>
    </div>

    <div id="successMessage">
        Appointment successfully booked!
    </div>

    <script>
        // Function to handle the button click event
        function confirmAppointment(doctorId) {
            if (confirm("Are you sure you want to book an appointment with this doctor?")) {
                bookAppointment(doctorId);
            }
        }

        // Function to send a request to book the appointment
        async function bookAppointment(doctorId) {
            try {
                const response = await fetch("/book-appointment", {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json"
                    },
                    body: JSON.stringify({ doctorId })
                });

                if (response.ok) {
                    showSuccessMessage(); // Show success message
                } else {
                    alert("Failed to book appointment. Please try again later.");
                }
            } catch (error) {
                console.error("Error booking appointment:", error);
                alert("An error occurred while booking appointment. Please try again later.");
            }
        }

        function showSuccessMessage() {
            const messageDiv = document.getElementById('successMessage');
            messageDiv.style.display = 'block'; // Show the success message
            setTimeout(() => {
                messageDiv.style.display = 'none'; // Hide after 2 seconds
                location.reload(); // Reload the page after hiding the message
            }, 2000);
        }
    </script>
</body>

</html>
