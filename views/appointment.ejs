<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>User Appointment Page</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <link href="https://fonts.googleapis.com/css2?family=Ubuntu:wght@700&display=swap" rel="stylesheet">
    <style>
        body {
            background-color: rgb(7, 198, 202);
            font-family: "Ubuntu", sans-serif; /* Ensure proper font fallback */
        }

        .card {
            width: 18rem; /* Adjust as needed */
            margin: 20px; /* Spacing between cards */
        }

        .container {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            padding: 20px; /* Add padding for aesthetics */
        }

        .book-button {
            color: rgb(7, 198, 202);
        }

        h1,
        h2 {
            text-align: center;
            color: white; /* Change to suit your design */
        }

        /* Center the success message */
        #successMessage {
            position: fixed;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            background-color: white;
            padding: 20px;
            border-radius: 5px;
            display: none; /* Hidden by default */
            z-index: 1000; /* Ensure it appears above other content */
        }
    </style>
</head>

<body>
    <div class="container">
        <h1>Get an Appointment!!!!</h1>
        <h2>Available Doctors</h2>

        <div class="container">
            <% doctors.forEach(doctor => { %>
                <div class="card">
                    <img src="<%= doctor.imageUrl %>" class="card-img-top" alt="<%= doctor.name %>">
                    <div class="card-body">
                        <h5 class="card-title">Dr. <%= doctor.name %></h5>
                        <p class="card-text">Price: Rs. <%= Math.floor(Math.random() * (1000 - 500 + 1)) + 500 %></p>
                        <button class="btn btn-outline-light book-button"
                                onclick="confirmAppointment('<%= doctor._id %>')">Book Appointment</button>
                    </div>
                </div>
            <% }); %>
        </div>
    </div>

    <div id="successMessage">
        Appointment successfully booked!
    </div>

    <script>
        function confirmAppointment(doctorId) {
            if (confirm("Are you sure you want to book an appointment with this doctor?")) {
                bookAppointment(doctorId);
            }
        }

        async function bookAppointment(doctorId) {
            try {
                const response = await fetch("/book-appointment", {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json"
                    },
                    body: JSON.stringify({ doctorId })
                });

                if (response.ok) {
                    showSuccessMessage(); // Show the success message
                    setTimeout(() => {
                        location.reload(); // Reload the page after 2 seconds
                    }, 2000);
                } else {
                    alert("Failed to book appointment. Please try again later.");
                }
            } catch (error) {
                console.error("Error booking appointment:", error);
                alert("An error occurred while booking appointment. Please try again later.");
            }
        }

        function showSuccessMessage() {
            const messageDiv = document.getElementById('successMessage');
            messageDiv.style.display = 'block'; // Show the success message
            setTimeout(() => {
                messageDiv.style.display = 'none'; // Hide after 2 seconds
            }, 2000);
        }
    </script>
</body>

</html>
