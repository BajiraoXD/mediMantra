<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>User Appointment Page</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <link href="https://fonts.googleapis.com/css2?family=Ubuntu:wght@700&display=swap" rel="stylesheet">
    <style>
        body {
            background-color: #0ccf2d;
            font-family: "Ubuntu";
        }

        .gg {
            border-radius: 100%;
            background-color: blanchedalmond;
        }

        .app-img {
            width: 100%;
            max-width: 300px;
            height: auto;
            margin-top: 20px;
        }

        table {
            border: white solid 2px;
            width: 100%;
            max-width: 600px;
            margin: 20px auto;
        }

        @media (max-width: 768px) {
            h1 {
                font-size: 1.8rem;
            }

            h2 {
                font-size: 1.4rem;
            }

            .app-img {
                max-width: 200px;
            }

            .book-button {
                font-size: 0.9rem;
            }
        }

        @media (max-width: 576px) {
            h1 {
                font-size: 1.5rem;
            }

            h2 {
                font-size: 1.2rem;
            }

            .book-button {
                font-size: 0.8rem;
            }
        }
    </style>
</head>

<body>
    <div class="container text-center p-3 py-5">
        <div class="col-12 p-3 py-5 gg">
            <h1>Get an Appointment!!!!</h1>
            <h2>Available Doctors</h2>
            <img class="app-img" src="/images/doc-dashboard-blog.png" alt="app">
            
            <!-- Doctor's Table -->
            <div class="table-responsive">
                <table class="table table-bordered text-center">
                    <thead>
                        <tr>
                            <th>Doctor Name</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% doctors.forEach(doctor => { %>
                        <tr>
                            <td style="color: #0ccf2d;">Dr. <%= doctor.name %></td>
                            <td>
                                <button class="btn btn-outline-light btn-sm book-button"
                                    onclick="confirmAppointment('<%= doctor._id %>')">Book Appointment</button>
                            </td>
                        </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>

            <div id="successMessage" style="display: none;">
                Appointment successfully booked!
            </div>
        </div>
    </div>

    <script>
        // JavaScript function to handle the button click event
        function confirmAppointment(doctorId) {
            if (confirm("Are you sure you want to book an appointment with this doctor?")) {
                bookAppointment(doctorId);
            }
        }

        async function bookAppointment(doctorId) {
            try {
                const response = await fetch("/book-appointment", {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json"
                    },
                    body: JSON.stringify({ doctorId })
                });

                if (response.ok) {
                    alert("Appointment successfully booked!");
                    location.reload();
                } else {
                    alert("Failed to book appointment. Please try again later.");
                }
            } catch (error) {
                console.error("Error booking appointment:", error);
                alert("An error occurred while booking appointment. Please try again later.");
            }
        }
    </script>
</body>

</html>
