<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Doctor Appointment Page</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <link href="https://fonts.googleapis.com/css2?family=Ubuntu:wght@700&display=swap" rel="stylesheet">
    <style>
        body {
            background-color: #0ccf2d;
            font-family: "Ubuntu", sans-serif;
        }

        .container {
            margin-top: 50px; /* Space from top */
        }

        .card {
            margin: 20px; /* Space between cards */
        }

        h1 {
            text-align: center;
            margin-bottom: 30px; /* Space below the title */
        }

        .app-img {
            height: 150px; /* Height of the image */
            display: block;
            margin: 0 auto; /* Center the image */
        }
    </style>
</head>

<body>
    <div class="container">
        <h1>You Got a Patient!</h1>

        <div class="card text-center">
            <div class="card-body">
                <h5 class="card-title">Patient Name</h5>
                <img src="/images/doctor.png" alt="Doctor Image" class="app-img">
                <p class="card-text">You have an appointment with:</p>
                <p class="patient-name">
                    <% names.forEach(name => { %>
                        <strong><%= name %></strong>
                    <% }); %>
                </p>
                <button onclick="confirmAppointment()"  class="btn btn-primary">Confirm Appointment</button>
            </div>
        </div>
    </div>

    <div id="successMessage" style="display: none;">
        <!-- This div will display the success message after booking -->
        Appointment successfully booked!
    </div>

    <script>
        // JavaScript function to handle appointment confirmation
        function confirmAppointment() {
            // Logic to confirm the appointment can be added here
            alert("Appointment confirmed!");
        }
    </script>
</body>

</html>
