<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <link href="https://fonts.googleapis.com/css2?family=Ubuntu:wght@700&display=swap" rel="stylesheet">
    <title>User Reports</title>
    <style>
        body {
            background-color: rgb(7, 198, 202);
            font-family: "Ubuntu", sans-serif;
        }

        .report-container {
            background-color: whitesmoke;
            margin-top: 2%;
            padding: 20px;
            border-radius: 10px;
        }

        .btn-download {
            background-color: rgb(7, 198, 202);
            color: white;
        }

        .btn-download:hover {
            opacity: 0.8;
        }

        h1 {
            text-align: center;
            margin-bottom: 20px;
        }

        .report-row {
            margin: 10px 0; /* Add space between rows */
        }
        a
        {
            text-decoration: none;
        }
    </style>
</head>

<body>
    <div class="container report-container">
        <h1>Get Patient Reports</h1>

        <div class="row">
            <% files.forEach(file => { %>
                <div class="col-12 report-row">
                    <div class="d-flex justify-content-between align-items-center">
                        <a href="/download/<%= file.filename %>" class="text-dark">
                            <%= file.filename %>
                        </a>
                        <a href="/download/<%= file.filename %>" class="btn btn-download btn-sm">Download</a>
                    </div>
                </div>
            <% }); %>
        </div>
    </div>
</body>

</html>
